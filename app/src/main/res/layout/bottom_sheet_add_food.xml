<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_pill_emerald"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Sheet Header -->
    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="افزودن غذا"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <!-- Live Search Input Box -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearchFood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/primary"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/text_secondary"
        android:hint="@string/search_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchFood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Horizontal Category Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="همه"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatStews"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="خورش‌ها" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatRice"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="برنج و پلو" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatDrinks"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نوشیدنی و کافه" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatKebabs"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="کباب‌ها" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatBreakfast"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صبحانه و لبنیات" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatTrad"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سنتی و آش" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatFast"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="فست‌فود" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatSnack"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="میوه و میان‌وعده" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Foods List (Popular / Filtered / Closest Results) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFoodSearchResults"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="4dp"
        android:scrollbars="vertical" />

    <!-- Selected Food Configuration Panel -->
    <LinearLayout
        android:id="@+id/layoutFoodConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_emerald"
        android:padding="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedFoodTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Quantity & Unit Inputs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <!-- Quantity Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="@color/primary"
                android:hint="تعداد / مقدار">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFoodQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="1"
                    android:gravity="center" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Unit Spinner -->
            <Spinner
                android:id="@+id/spFoodUnit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_card_clean" />
        </LinearLayout>

        <!-- Calculated Live Preview -->
        <TextView
            android:id="@+id/tvLiveCalculatedCalories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:text="کالری محاسبه‌شده: ۲۵۰ kcal" />

        <!-- Confirm Add Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddFoodToMeal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/confirm_add"
            android:textColor="@color/surface_white"
            app:backgroundTint="@color/primary"
            app:cornerRadius="16dp"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</LinearLayout>
