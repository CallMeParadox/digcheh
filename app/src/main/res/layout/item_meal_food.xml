<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:background="?attr/selectableItemBackground">

    <!-- Food Item Summary Row (Always Visible) -->
    <LinearLayout
        android:id="@+id/layoutFoodHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp">

        <!-- Food Name and Quantity -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFoodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="قورمه‌سبزی بدون برنج"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFoodQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۱ پیاله خورش‌خوری (۲۰۰ گرم)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Calories and Chevron -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFoodCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۲۸۰ kcal"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/ivChevron"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/text_hint" />
        </LinearLayout>
    </LinearLayout>

    <!-- Expandable Accordion for Macros & Delete (Progressive Disclosure) -->
    <LinearLayout
        android:id="@+id/layoutMacrosExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- Macro Badges -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProteinBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="پروتئین: ۱۸g"
                    android:textColor="@color/macro_protein"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvCarbBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="کربو: ۱۵g"
                    android:textColor="@color/macro_carb"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvFatBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="چربی: ۱۲g"
                    android:textColor="@color/macro_fat"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Delete Button -->
            <ImageButton
                android:id="@+id/btnDeleteFood"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_trash"
                android:contentDescription="@string/delete"
                app:tint="@color/danger" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtle Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="8dp" />
</LinearLayout>
